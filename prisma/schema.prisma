generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  CLEANER
  ADMIN
}

enum JobRequestStatus {
  OPEN
  AWARDED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum TimingPreference {
  ASAP
  TIME_SLOT
}

enum BidStatus {
  SUBMITTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum BidPricingType {
  HOURLY
  FLAT
}

enum ServiceNeed {
  GENERAL_CLEANING
  DEEP_CLEAN
  KITCHEN
  BATHROOMS
  FLOORS
  DUSTING
  MOVE_OUT
  WINDOWS
  LAUNDRY
}

enum RoomType {
  KITCHEN
  BATHROOM
  BEDROOM
  LIVING_AREA
  DINING_ROOM
  ENTRYWAY
  OFFICE
  LAUNDRY
}

enum PriorityType {
  GENERAL_DUST
  DEEP_BATHROOM
  DEEP_KITCHEN
  FLOORS
  MOVE_OUT_TOUCHES
  WINDOWS
  ORGANIZING
}

enum BidSelectionPriority {
  CHEAPEST
  FASTEST
  BEST_QUALITY
  BEST_OVERALL
}

enum CleanerLeadSource {
  MANUAL
  GOOGLE_PLACES
  WEBSITE
  REFERRAL
}

enum OutreachChannel {
  APP
  SMS
  VAPI_CALL
  MANUAL_CALL
}

enum JobOutreachStatus {
  PENDING
  SENT
  DELIVERED
  INTERESTED
  NOT_INTERESTED
  INVITE_SENT
  ONBOARDED
  BID_SUBMITTED
  FAILED
  OPTED_OUT
}

enum OutreachEventType {
  CREATED
  SENT
  DELIVERED
  INTERESTED
  NOT_INTERESTED
  INVITE_SENT
  ONBOARDED
  BID_SUBMITTED
  FAILED
  OPTED_OUT
  NOTE_ADDED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPTED_OUT
  SKIPPED
}

enum EntryMethod {
  HIDDEN_KEY
  DOOR_CODE
  BUZZ_IN
  I_WILL_BE_HOME
  FRONT_DESK
  OTHER
}

enum SuppliesSource {
  CLEANER_BRINGS_ALL
  HOMEOWNER_PROVIDES
  MIXED
}

enum CleanLevel {
  LIGHT
  MEDIUM
  DEEP
}

enum JobCleanType {
  STANDARD_CLEAN
  DEEP_CLEAN
  MOVE_OUT_CLEAN
  RECURRING_CLEAN
  ASAP_REFRESH
}

enum HomeCondition {
  LIGHT_TOUCH_UP
  NORMAL_LIVED_IN
  NEEDS_EXTRA_ATTENTION
}

enum JobPriorityArea {
  KITCHEN
  BATHROOMS
  FLOORS
  PET_HAIR
  INSIDE_FRIDGE
  INSIDE_OVEN
}

enum BookingStatus {
  PENDING_PAYMENT
  BOOKED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum BookingEventType {
  BOOKING_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  STATUS_CHANGED
}

model User {
  id                             String                 @id @default(cuid())
  role                           UserRole
  firstName                      String
  lastName                       String
  email                          String?                @unique
  emailVerifiedAt                DateTime?
  phone                          String?
  phoneVerifiedAt                DateTime?
  homeownerOnboardingCompletedAt DateTime?
  pushNotificationsRequestedAt   DateTime?
  pushNotificationsEnabled       Boolean                @default(false)
  heardAboutUs                   String?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  cleanerProfile                 CleanerProfile?
  homeProfiles                   HomeProfile[]
  customerBookings               Booking[]              @relation("CustomerBookings")
  cleanerBookings                Booking[]              @relation("CleanerBookings")
  customerJobRequests            JobRequest[]           @relation("CustomerJobRequests")
  cleanerBids                    JobBid[]               @relation("CleanerBids")
  cleanerJobPasses               CleanerJobPass[]
  bookingEvents                  BookingEvent[]
  sessions                       Session[]
  phoneIdentity                  PhoneIdentity?
  linkedCleanerLeads             CleanerLead[]          @relation("LinkedCleanerLeadUser")
  jobOutreaches                  JobOutreach[]          @relation("OutreachCleanerUser")
  notificationDeliveries         NotificationDelivery[]
  pushSubscriptions              PushSubscription[]
}

model OtpChallenge {
  id          String    @id @default(cuid())
  channel     String
  destination String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([channel, destination, consumedAt])
}

model PhoneIdentity {
  id              String   @id @default(cuid())
  phone           String
  phoneVerifiedAt DateTime @default(now())
  userId          String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CleanerProfile {
  id                             String        @id @default(cuid())
  userId                         String        @unique
  isAvailable                    Boolean       @default(true)
  bio                            String?
  avatarUrl                      String?
  businessName                   String?
  website                        String?
  headline                       String?
  hourlyRateFromCents            Int?
  standardHourlyRateCents        Int?
  standardFlatRateCents          Int?
  standardDeepCleanFlatRateCents Int?
  defaultEtaMinutes              Int?
  flatRateAvailable              Boolean       @default(false)
  bidTemplatesEnabled            Boolean       @default(true)
  googleRating                   Float?
  googleReviewCount              Int?
  googleReviewSummary            String?
  externalReviewSource           String?
  licensedAndInsured             Boolean       @default(false)
  serviceAreaPostalCodes         String[]      @default([])
  serviceNeeds                   ServiceNeed[] @default([])
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt
  user                           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HomeProfile {
  id                   String         @id @default(cuid())
  label                String         @default("My Home")
  propertyType         PropertyType   @default(HOUSE)
  bedroomCount         Int?
  bathroomCount        Float?
  estimatedSquareFeet  Int?
  storyCount           Int?
  hasPets              Boolean        @default(false)
  addressLine1         String
  addressLine2         String?
  city                 String
  state                String
  postalCode           String
  googlePlaceId        String?
  entryMethod          EntryMethod    @default(I_WILL_BE_HOME)
  entryNotes           String?
  suppliesSource       SuppliesSource @default(CLEANER_BRINGS_ALL)
  defaultRoomTypes     RoomType[]     @default([])
  defaultCleanLevel    CleanLevel     @default(MEDIUM)
  roomCleanLevels      Json           @default("{}")
  defaultPriorityTypes PriorityType[] @default([])
  notes                String?
  isDefault            Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  customerId           String
  customer             User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobRequests          JobRequest[]
}

enum PropertyType {
  HOUSE
  APARTMENT
}

model JobRequest {
  id                            String               @id @default(cuid())
  title                         String
  addressLine1                  String
  addressLine2                  String?
  city                          String
  state                         String
  postalCode                    String
  serviceNeeds                  ServiceNeed[]
  roomTypes                     RoomType[]           @default([])
  cleanLevel                    CleanLevel           @default(MEDIUM)
  roomCleanLevels               Json                 @default("{}")
  cleanType                     JobCleanType?
  currentCondition              HomeCondition?
  matchingPriorityAreas         JobPriorityArea[]    @default([])
  priorityTypes                 PriorityType[]       @default([])
  selectionPriority             BidSelectionPriority @default(BEST_OVERALL)
  entryMethod                   EntryMethod          @default(I_WILL_BE_HOME)
  entryNotes                    String?
  suppliesSource                SuppliesSource       @default(CLEANER_BRINGS_ALL)
  timingPreference              TimingPreference
  requestedDate                 DateTime?
  requestedWindowStart          String?
  requestedWindowEnd            String?
  notes                         String?
  customerCompletedJobsSnapshot Int                  @default(0)
  customerMemberSinceSnapshot   DateTime?
  cleanersNotifiedCount         Int                  @default(0)
  viewCount                     Int                  @default(0)
  status                        JobRequestStatus     @default(OPEN)
  acceptedAt                    DateTime?
  completedAt                   DateTime?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  customerId                    String
  homeProfileId                 String?
  acceptedBidId                 String?              @unique
  customer                      User                 @relation("CustomerJobRequests", fields: [customerId], references: [id], onDelete: Cascade)
  homeProfile                   HomeProfile?         @relation(fields: [homeProfileId], references: [id], onDelete: SetNull)
  acceptedBid                   JobBid?              @relation("AcceptedJobBid", fields: [acceptedBidId], references: [id], onDelete: SetNull)
  bids                          JobBid[]             @relation("JobRequestBids")
  outreaches                    JobOutreach[]
  cleanerPasses                 CleanerJobPass[]
}

model JobBid {
  id                    String         @id @default(cuid())
  pricingType           BidPricingType
  hourlyRateCents       Int?
  flatRateCents         Int?
  estimatedHours        Float?
  arrivalDate           DateTime?
  arrivalWindowStart    String?
  arrivalWindowEnd      String?
  etaMinutes            Int?
  message               String?
  status                BidStatus      @default(SUBMITTED)
  customerViewedAt      DateTime?
  cleanerViewedAt       DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  jobRequestId          String
  cleanerId             String
  jobRequest            JobRequest     @relation("JobRequestBids", fields: [jobRequestId], references: [id], onDelete: Cascade)
  cleaner               User           @relation("CleanerBids", fields: [cleanerId], references: [id], onDelete: Cascade)
  acceptedForJobRequest JobRequest?    @relation("AcceptedJobBid")
  outreach              JobOutreach?

  @@unique([jobRequestId, cleanerId])
}

model CleanerJobPass {
  id           String     @id @default(cuid())
  cleanerId    String
  jobRequestId String
  passedAt     DateTime   @default(now())
  cleaner      User       @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, jobRequestId])
  @@index([cleanerId, passedAt])
}

model CleanerLead {
  id                     String                 @id @default(cuid())
  name                   String?
  businessName           String?
  phone                  String
  website                String?
  source                 CleanerLeadSource      @default(MANUAL)
  city                   String?
  state                  String?
  postalCode             String?
  serviceAreaPostalCodes String[]               @default([])
  googleRating           Float?
  googleReviewCount      Int?
  optedOutAt             DateTime?
  optOutReason           String?
  consentedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  linkedCleanerUserId    String?
  linkedCleanerUser      User?                  @relation("LinkedCleanerLeadUser", fields: [linkedCleanerUserId], references: [id], onDelete: SetNull)
  outreaches             JobOutreach[]
  notificationDeliveries NotificationDelivery[]

  @@unique([phone])
  @@index([postalCode])
}

model JobOutreach {
  id                     String                 @id @default(cuid())
  channel                OutreachChannel
  status                 JobOutreachStatus      @default(PENDING)
  interestToken          String                 @unique
  interestTokenExpiresAt DateTime
  lastAttemptAt          DateTime?
  attemptCount           Int                    @default(0)
  providerCallId         String?
  providerMessageId      String?
  failureReason          String?
  notes                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  jobRequestId           String
  cleanerUserId          String?
  cleanerLeadId          String?
  bidId                  String?                @unique
  jobRequest             JobRequest             @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  cleanerUser            User?                  @relation("OutreachCleanerUser", fields: [cleanerUserId], references: [id], onDelete: SetNull)
  cleanerLead            CleanerLead?           @relation(fields: [cleanerLeadId], references: [id], onDelete: SetNull)
  bid                    JobBid?                @relation(fields: [bidId], references: [id], onDelete: SetNull)
  events                 OutreachEvent[]
  notificationDeliveries NotificationDelivery[]

  @@index([jobRequestId, status])
  @@index([cleanerUserId])
  @@index([cleanerLeadId])
}

model OutreachEvent {
  id            String            @id @default(cuid())
  eventType     OutreachEventType
  payload       Json              @default("{}")
  createdAt     DateTime          @default(now())
  jobOutreachId String
  jobOutreach   JobOutreach       @relation(fields: [jobOutreachId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  dedupeKey         String?             @unique
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  toEmail           String?
  toPhone           String?
  providerMessageId String?
  payload           Json                @default("{}")
  failureReason     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sentAt            DateTime?
  deliveredAt       DateTime?
  jobOutreachId     String?
  jobRequestId      String?
  userId            String?
  cleanerLeadId     String?
  jobOutreach       JobOutreach?        @relation(fields: [jobOutreachId], references: [id], onDelete: SetNull)
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  cleanerLead       CleanerLead?        @relation(fields: [cleanerLeadId], references: [id], onDelete: SetNull)

  @@index([providerMessageId])
  @@index([jobOutreachId])
  @@index([cleanerLeadId])
  @@index([jobRequestId])
  @@index([userId])
}

model PushSubscription {
  id         String    @id @default(cuid())
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  disabledAt DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

model Service {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  description     String
  basePriceCents  Int
  durationMinutes Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

model AddOn {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  description     String
  priceCents      Int
  durationMinutes Int
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  bookingItems    BookingAddOn[]
}

model TimeSlot {
  id        String    @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@unique([startsAt, endsAt])
}

model Booking {
  id                      String         @id @default(cuid())
  bookingNumber           String         @unique
  status                  BookingStatus
  paymentStatus           PaymentStatus
  subtotalCents           Int
  addOnTotalCents         Int
  taxCents                Int
  totalCents              Int
  addressLine1            String
  addressLine2            String?
  city                    String
  state                   String
  postalCode              String
  bedrooms                Int
  bathrooms               Float
  notes                   String?
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  expiresAt               DateTime?
  paidAt                  DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  customerId              String
  cleanerId               String
  serviceId               String
  slotId                  String
  customer                User           @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  cleaner                 User           @relation("CleanerBookings", fields: [cleanerId], references: [id], onDelete: Cascade)
  service                 Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  slot                    TimeSlot       @relation(fields: [slotId], references: [id], onDelete: Restrict)
  addOns                  BookingAddOn[]
  events                  BookingEvent[]
}

model BookingAddOn {
  id              String  @id @default(cuid())
  quantity        Int
  unitPriceCents  Int
  totalPriceCents Int
  bookingId       String
  addOnId         String
  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn           AddOn   @relation(fields: [addOnId], references: [id], onDelete: Restrict)
}

model BookingEvent {
  id         String           @id @default(cuid())
  eventType  BookingEventType
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  note       String?
  createdAt  DateTime         @default(now())
  bookingId  String
  actorId    String?
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
}
